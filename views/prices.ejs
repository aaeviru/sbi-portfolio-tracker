<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" type="text/css" href="/menu.css">
  <title>Price Update</title>
  <style>
    body {
      margin: 0;
      font-family: sans-serif;
      color: #172126;
      background: #f4f6f7;
    }

    .content {
      margin: 22px;
    }

    .page-header,
    .toolbar,
    .progress-line {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .page-header {
      justify-content: space-between;
      margin-bottom: 12px;
    }

    h1 {
      margin: 0;
      font-size: 28px;
      letter-spacing: 0;
    }

    button {
      min-height: 34px;
      border: 1px solid #6e7f87;
      background: #fff;
      color: #172126;
      padding: 6px 11px;
      cursor: pointer;
    }

    button.primary {
      border-color: #1f6a87;
      background: #1f6a87;
      color: #fff;
    }

    button:disabled {
      cursor: default;
      opacity: 0.5;
    }

    .message,
    .progress-line {
      border: 1px solid #bac8ce;
      background: #fff;
      padding: 8px 10px;
    }

    .toolbar {
      margin: 12px 0;
    }

    .filter-group {
      display: inline-flex;
    }

    .filter-group button + button {
      border-left: 0;
    }

    .filter-group button.active {
      background: #35444b;
      color: #fff;
    }

    progress {
      width: min(360px, 65vw);
      height: 14px;
    }

    .split-panel { border: 1px solid #aebdc4; background: #fff; padding: 14px; margin: 16px 0; }
    .split-panel h2 { margin: 0 0 8px; font-size: 20px; }
    .split-panel h3 { margin: 16px 0 8px; font-size: 16px; }
    .split-panel p { margin: 6px 0 12px; }
    .split-card { border: 1px solid #d0d9dd; padding: 12px; margin: 10px 0; }
    .split-card.pending { border-color: #b07a18; background: #fffbf0; }
    .split-alert { border-color: #ad4f48; background: #fbe9e7; }
    .split-facts, .split-actions, .manual-fields { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
    .split-facts span { min-width: 120px; }
    .split-actions { margin-top: 10px; }
    .split-panel label { display: flex; flex-direction: column; gap: 4px; }
    .split-panel input, .split-panel select { min-height: 32px; border: 1px solid #8899a1; padding: 4px 6px; }
    .split-preview { min-width: 620px; width: auto; margin: 8px 0; }
    .split-preview th { position: static; }
    .split-preview td { white-space: nowrap; }
    .table-scroll {
      overflow-x: auto;
      border: 1px solid #aebdc4;
      background: #fff;
    }

    table {
      width: 100%;
      min-width: 1460px;
      border-collapse: collapse;
      font-size: 13px;
    }

    th,
    td {
      border-bottom: 1px solid #d4dde1;
      padding: 7px 8px;
      text-align: left;
      vertical-align: middle;
      white-space: nowrap;
    }

    th {
      position: sticky;
      top: 0;
      z-index: 1;
      background: #314f5d;
      color: #fff;
      font-weight: 600;
    }

    tbody tr:nth-child(even) {
      background: #edf3f5;
    }

    tbody tr[hidden] {
      display: none;
    }

    .asset-name {
      width: 300px;
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .number {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .status {
      display: inline-block;
      min-width: 82px;
      padding: 3px 6px;
      border: 1px solid #87969d;
      background: #f5f7f8;
      text-align: center;
    }

    .status-up-to-date {
      border-color: #43805f;
      background: #e5f3ea;
      color: #24573d;
    }

    .status-needs-update {
      border-color: #b07a18;
      background: #fff4d8;
      color: #724c0a;
    }

    .status-failed {
      border-color: #ad4f48;
      background: #fbe9e7;
      color: #792d28;
    }

    details summary {
      cursor: pointer;
      color: #155675;
    }

    .interval-table {
      min-width: 760px;
      margin-top: 6px;
      border: 1px solid #c4d0d5;
    }

    .interval-table th {
      position: static;
      background: #637983;
    }

    .error {
      max-width: 240px;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #792d28;
    }

    @media (max-width: 720px) {
      .content {
        margin: 14px 10px;
      }

      .page-header {
        align-items: flex-start;
      }
    }
  </style>
  <script>
    function highlightNav() {
      var item = document.getElementById('prices');
      if (item) item.className += ' active';
    }

    function formatNumbers() {
      var cells = document.querySelectorAll('[data-number]');
      for (var i = 0; i < cells.length; i++) {
        var raw = cells[i].getAttribute('data-number');
        if (raw === '') {
          cells[i].textContent = '-';
          continue;
        }
        var value = Number(raw);
        cells[i].textContent = isFinite(value) ? value.toLocaleString(undefined, { maximumFractionDigits: 4 }) : '';
      }
    }

    function setFilter(filter) {
      var buttons = document.querySelectorAll('[data-filter]');
      var rows = document.querySelectorAll('#price-rows > tr');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.toggle('active', buttons[i].getAttribute('data-filter') == filter);
      }
      for (var j = 0; j < rows.length; j++) {
        var status = rows[j].getAttribute('data-status');
        rows[j].hidden = filter != 'ALL' && status != filter;
      }
    }

    function updateProgress(status) {
      var line = document.getElementById('refresh-progress');
      var meter = document.getElementById('refresh-meter');
      var text = document.getElementById('refresh-text');
      var updateButton = document.getElementById('update-all');
      if (!line || !meter || !text) return;
      line.hidden = status.status == 'IDLE';
      meter.max = Math.max(1, Number(status.totalAssets || 0));
      meter.value = Number(status.processedAssets || 0);
      text.textContent = status.status == 'RUNNING'
        ? 'Refreshing ' + (status.currentSymbol || '') + '  ' + status.processedAssets + ' / ' + status.totalAssets + '  History requests: ' + status.historyRequests
        : 'Last refresh: ' + status.status + '  OK: ' + status.ok + '  Failed: ' + status.failed + '  History requests: ' + status.historyRequests;
      if (updateButton) updateButton.disabled = status.status == 'RUNNING';
      var importLine = document.getElementById('import-split-progress');
      if (importLine && status.importSplitScan) {
        importLine.hidden = status.importSplitScan.status != 'RUNNING';
        importLine.textContent = 'Checking Yahoo split history after import: ' + (status.importSplitScan.currentSymbol || 'starting');
      }
    }

    function pollRefresh() {
      fetch('/prices/status', { headers: { 'Accept': 'application/json' } })
        .then(function (response) { return response.json(); })
        .then(function (status) {
          updateProgress(status);
          if (status.status == 'RUNNING' || (status.importSplitScan && status.importSplitScan.status == 'RUNNING')) {
            window.setTimeout(pollRefresh, 1500);
          } else if (document.body.getAttribute('data-initial-status') == 'RUNNING' || document.body.getAttribute('data-initial-import-status') == 'RUNNING') {
            window.location.reload();
          }
        });
    }

    window.onload = function () {
      highlightNav();
      formatNumbers();
      setFilter('ALL');
      if (document.body.getAttribute('data-initial-status') == 'RUNNING' || document.body.getAttribute('data-initial-import-status') == 'RUNNING') {
        pollRefresh();
      }
    };
  </script>
</head>

<body data-initial-status="<%= refreshStatus.status %>" data-initial-import-status="<%= refreshStatus.importSplitScan ? refreshStatus.importSplitScan.status : 'IDLE' %>">
  <%- include('partials/menu'); -%>
  <main class="content">
    <div class="page-header">
      <div>
        <h1>Price Update</h1>
        <div>Report date (JST): <strong><%= reportDate %></strong></div>
      </div>
      <form action="/prices/refresh" method="post">
        <button id="update-all" class="primary" type="submit" <%= refreshStatus.status == 'RUNNING' ? 'disabled' : '' %>>Update All</button>
      </form>
    </div>

    <% if (message) { %>
      <div class="message"><%= message %></div>
    <% } %>

    <div id="refresh-progress" class="progress-line" <%= refreshStatus.status == 'IDLE' ? 'hidden' : '' %>>
      <progress id="refresh-meter" max="<%= Math.max(1, refreshStatus.totalAssets || 0) %>" value="<%= refreshStatus.processedAssets || 0 %>"></progress>
      <span id="refresh-text">
        <% if (refreshStatus.status == 'RUNNING') { %>
          Refreshing <%= refreshStatus.currentSymbol %> <%= refreshStatus.processedAssets %> / <%= refreshStatus.totalAssets %>
        <% } else { %>
          Last refresh: <%= refreshStatus.status %> &nbsp; OK: <%= refreshStatus.ok %> &nbsp; Failed: <%= refreshStatus.failed %> &nbsp; History requests: <%= refreshStatus.historyRequests %>
        <% } %>
      </span>
    </div>

    <div id="import-split-progress" class="progress-line" <%= !refreshStatus.importSplitScan || refreshStatus.importSplitScan.status != 'RUNNING' ? 'hidden' : '' %>>
      Checking Yahoo split history after import: <%= refreshStatus.importSplitScan && refreshStatus.importSplitScan.currentSymbol || 'starting' %>
    </div>

    <section class="split-panel" aria-labelledby="split-heading">
      <h2 id="split-heading">Stock split events</h2>
      <p>Yahoo Japan split rows are suggestions. Portfolio figures change only after you confirm an event. Original SBI trades stay intact.</p>
      <% splitScanAlerts.forEach(function (scan) { %>
        <div class="split-card split-alert"><strong><%= scan.symbol %> split check: <%= scan.status %></strong>
          <span><%= scan.status == 'FAILED' ? scan.lastError : scan.warning %></span>
          <% if (scan.lastAttemptAt) { %><small>Checked <%= scan.lastAttemptAt %></small><% } %>
        </div>
      <% }); %>
      <% if (!stockSplitCandidates.length) { %><p>No pending split events.</p><% } %>
      <% stockSplitCandidates.forEach(function (event) { %>
        <div class="split-card pending">
          <div class="split-facts">
            <span><strong><%= event.symbol %></strong></span>
            <span>Ex-rights date: <strong><%= event.exDate %></strong></span>
            <span><strong><%= event.operation == 'REMOVE' ? 'Remove split' : event.beforeShares + ' shares → ' + event.afterShares + ' shares' %></strong></span>
            <span><%= event.source == 'MANUAL' ? 'Manual entry' : 'Yahoo Japan history' %></span>
            <% if (event.sourceUrl) { %><a href="<%= event.sourceUrl %>" target="_blank" rel="noopener noreferrer">View Yahoo source</a><% } %>
            <span>Found: <%= event.observedAt %></span>
          </div>
          <% if (event.replacesId) { %><p>Correction of confirmed event <%= event.replacesId %>.</p><% } %>
          <% if (event.preview.before && event.preview.after) { %>
            <div class="table-scroll"><table class="split-preview">
              <thead><tr><th>Impact</th><th>Shares</th><th>Remaining cost</th><th>Market value</th><th>Unrealized P/L</th><th>Realized P/L</th></tr></thead>
              <tbody>
                <% [['Current', event.preview.before], ['After confirmation', event.preview.after]].forEach(function (item) { %>
                  <tr><td><%= item[0] %></td><td class="number" data-number="<%= item[1].netQty %>"></td><td class="number" data-number="<%= item[1].remainingCost %>"></td><td class="number" data-number="<%= item[1].marketValue == null ? '' : item[1].marketValue %>"></td><td class="number" data-number="<%= item[1].unrealizedPl == null ? '' : item[1].unrealizedPl %>"></td><td class="number" data-number="<%= item[1].realizedPl %>"></td></tr>
                <% }); %>
              </tbody>
            </table></div>
          <% } %>
          <div class="split-actions">
            <form action="/prices/splits/<%= encodeURIComponent(event.id) %>/confirm" method="post"><button class="primary" type="submit">Confirm and apply</button></form>
            <form action="/prices/splits/<%= encodeURIComponent(event.id) %>/dismiss" method="post"><button type="submit">Dismiss</button></form>
          </div>
        </div>
      <% }); %>
      <h3>Add or correct a split manually</h3>
      <form action="/prices/splits/manual" method="post">
        <div class="manual-fields">
          <label>Action<select name="operation"><option value="ADD">Add split</option><option value="REPLACE">Correct confirmed split</option><option value="REMOVE">Remove confirmed split</option></select></label>
          <label>Symbol<input name="symbol" placeholder="8316.T" required></label>
          <label>Ex-rights date (add/correct)<input name="exDate" type="date"></label>
          <label>Before shares<input name="beforeShares" type="number" min="0.000001" step="any" placeholder="1"></label>
          <label>After shares<input name="afterShares" type="number" min="0.000001" step="any" placeholder="2"></label>
          <label>Confirmed event to correct<select name="replacesId"><option value="">None</option>
            <% confirmedSplits.forEach(function (event) { %><option value="<%= event.id %>"><%= event.symbol %> <%= event.exDate %> <%= event.beforeShares %>→<%= event.afterShares %></option><% }); %>
          </select></label>
          <button type="submit">Review manual entry</button>
        </div>
      </form>
      <% if (confirmedSplits.length) { %>
        <h3>Confirmed splits</h3>
        <% confirmedSplits.forEach(function (event) { %>
          <div><%= event.symbol %> · <%= event.exDate %> · <%= event.beforeShares %> → <%= event.afterShares %> shares · <%= event.source == 'MANUAL' ? 'manual' : 'Yahoo Japan' %></div>
        <% }); %>
      <% } %>
    </section>

    <div class="toolbar">
      <div class="filter-group" role="group" aria-label="Price status filter">
        <button type="button" data-filter="ALL" onclick="setFilter('ALL')">All</button>
        <button type="button" data-filter="NEEDS_UPDATE" onclick="setFilter('NEEDS_UPDATE')">Needs update</button>
        <button type="button" data-filter="FAILED" onclick="setFilter('FAILED')">Failed</button>
        <button type="button" data-filter="UP_TO_DATE" onclick="setFilter('UP_TO_DATE')">Up to date</button>
      </div>
    </div>

    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Status</th>
            <th>Asset</th>
            <th>Symbol</th>
            <th>Current Price</th>
            <th>Provider Price Date</th>
            <th>Completed History</th>
            <th>Live Snapshot</th>
            <th>Pending</th>
            <th>Provider</th>
            <th>Last Attempt</th>
            <th>Next Retry</th>
            <th>Error</th>
            <th>Coverage</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="price-rows">
          <% rows.forEach(function (row) { %>
            <tr data-status="<%= row.status %>">
              <td><span class="status status-<%= row.status.toLowerCase().replace(/_/g, '-') %>"><%= row.status.replace(/_/g, ' ') %></span></td>
              <td class="asset-name" title="<%= row.name %>"><%= row.name %></td>
              <td><%= row.symbol %></td>
              <td class="number" data-number="<%= row.currentPrice %>"></td>
              <td title="<%= row.currentPriceDateBasis %> <%= row.currentPriceSourceTimezone %>"><%= row.currentPriceDate || '-' %></td>
              <td><%= row.firstCompletedDate && row.lastCompletedDate ? row.firstCompletedDate + ' to ' + row.lastCompletedDate : '-' %></td>
              <td><%= row.latestSnapshotDate || '-' %></td>
              <td class="number"><%= row.pendingCount %><%= row.deferredCount ? ' (deferred ' + row.deferredCount + ')' : '' %></td>
              <td><%= row.sources || '-' %></td>
              <td><%= row.lastAttemptAt || '-' %></td>
              <td><%= row.nextRetryAt || '-' %></td>
              <td class="error" title="<%= row.historyError || row.priceError %>"><%= row.historyError || row.priceError || '-' %></td>
              <td>
                <details>
                  <summary><%= row.intervals.length %> intervals</summary>
                  <table class="interval-table">
                    <thead>
                      <tr><th>Source</th><th>Range</th><th>Status</th><th>Reason</th><th>Attempt</th><th>Retry</th></tr>
                    </thead>
                    <tbody>
                      <% row.intervals.forEach(function (interval) { %>
                        <tr>
                          <td><%= interval.source %></td>
                          <td><%= interval.startDate %> to <%= interval.endDate %></td>
                          <td><%= interval.status %></td>
                          <td><%= interval.reason || '-' %></td>
                          <td><%= interval.attemptCount || 0 %></td>
                          <td><%= interval.retryAfter || '-' %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </details>
              </td>
              <td>
                <form action="/prices/<%= encodeURIComponent(row.symbol) %>/refresh" method="post">
                  <button type="submit" <%= refreshStatus.status == 'RUNNING' ? 'disabled' : '' %>>Retry</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
</body>

</html>
