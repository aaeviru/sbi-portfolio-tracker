<html>

<head>
  <meta charset="utf-8">
  <link rel="stylesheet" type="text/css" href="/menu.css">
  <script type="text/javascript">
    function navbarHighLight() {
      var now = document.getElementById("daily-report");
      if (now)
        now.className += " active";
    }

    function formatNumber(value) {
      return Number(value || 0).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    window.onload = function () {
      navbarHighLight();
      var cells = document.querySelectorAll('[data-number]');
      for (var i = 0; i < cells.length; i++) {
        cells[i].textContent = formatNumber(cells[i].getAttribute('data-number'));
      }
    };

    function copyChatGptPrompt(id) {
      var prompt = document.getElementById(id || 'chatgpt-prompt');
      if (!prompt) {
        return;
      }
      prompt.select();
      prompt.setSelectionRange(0, prompt.value.length);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(prompt.value);
      } else {
        document.execCommand('copy');
      }
    }
  </script>
  <style>
    .content {
      margin: 24px;
      font-family: sans-serif;
      max-width: 1180px;
    }

    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 16px 0;
      flex-wrap: wrap;
    }

    .message {
      margin: 12px 0;
      padding: 10px 12px;
      border: 1px solid #b7d7b7;
      background: #eef8ee;
    }

    .error {
      margin: 12px 0;
      padding: 10px 12px;
      border: 1px solid #e0a0a0;
      background: #fff0f0;
      color: #900;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
      margin: 16px 0;
    }

    .metric {
      border: 1px solid #c7d9e3;
      padding: 10px;
      background: #f7fbfd;
    }

    .metric span {
      display: block;
      color: #555;
      font-size: 12px;
      margin-bottom: 6px;
    }

    .metric strong {
      font-size: 18px;
      font-variant-numeric: tabular-nums;
    }

    .negative {
      color: #f00;
    }

    .report {
      border: 1px solid #c7d9e3;
      background: #fff;
      padding: 16px;
      white-space: pre-wrap;
      line-height: 1.5;
      overflow-x: auto;
    }

    table {
      border-collapse: collapse;
      min-width: 720px;
      font-size: 14px;
      margin: 16px 0;
    }

    th,
    td {
      border: 1px solid #c7d9e3;
      padding: 5px 7px;
      white-space: nowrap;
    }

    th {
      background: #2f6f91;
      color: #fff;
      text-align: left;
    }

    .number {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .content ul {
      list-style-type: disc;
      margin: 12px 0 12px 24px;
      padding: 0;
      overflow: visible;
      background: transparent;
    }

    .content li {
      float: none;
    }

    .content li a {
      display: inline;
      color: #0645ad;
      padding: 0;
      text-align: left;
      text-decoration: underline;
    }

    .content li a:hover {
      background: transparent;
    }

    .muted {
      color: #666;
    }

    .prompt-box {
      width: 100%;
      min-height: 260px;
      box-sizing: border-box;
      font-family: Consolas, monospace;
      font-size: 13px;
      line-height: 1.4;
      padding: 10px;
      border: 1px solid #c7d9e3;
      margin-bottom: 18px;
    }

    .prompt-heading {
      margin: 16px 0 8px;
    }
  </style>
</head>

<body>
  <%- include('partials/menu'); -%>
  <div class="content">
    <h1>Daily Report</h1>

    <% if (message) { %>
      <div class="message"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form class="toolbar" action="/daily-report/generate" method="post">
      <label>
        Report date
        <input type="date" name="reportDate" value="<%= snapshot.reportDate %>">
      </label>
      <button type="submit">Generate today's report</button>
      <% if (!hasOpenAiKey) { %>
        <span class="muted">Set OPENAI_API_KEY before generating.</span>
      <% } %>
    </form>

    <h2>Use ChatGPT Chat Instead</h2>
    <p class="muted">Copy one of these prompts into ChatGPT. They use the same local snapshot, but ChatGPT handles the writing and web/news context in the chat UI.</p>

    <h3 class="prompt-heading">English</h3>
    <div class="toolbar">
      <button type="button" onclick="copyChatGptPrompt('chatgpt-prompt')">Copy English prompt</button>
    </div>
    <textarea id="chatgpt-prompt" class="prompt-box" readonly><%= chatGptPrompt %></textarea>

    <h3 class="prompt-heading">中文</h3>
    <div class="toolbar">
      <button type="button" onclick="copyChatGptPrompt('chatgpt-prompt-cn')">Copy Chinese prompt</button>
    </div>
    <textarea id="chatgpt-prompt-cn" class="prompt-box" readonly><%= chatGptPromptCn %></textarea>

    <h3 class="prompt-heading">日本語</h3>
    <div class="toolbar">
      <button type="button" onclick="copyChatGptPrompt('chatgpt-prompt-ja')">Copy Japanese prompt</button>
    </div>
    <textarea id="chatgpt-prompt-ja" class="prompt-box" readonly><%= chatGptPromptJa %></textarea>

    <h2>Current Local Snapshot</h2>
    <div class="summary-grid">
      <div class="metric"><span>Market value</span><strong class="<%= snapshot.totals.marketValue < 0 ? 'negative' : '' %>" data-number="<%= snapshot.totals.marketValue %>"></strong></div>
      <div class="metric"><span>Unrealized P/L</span><strong class="<%= snapshot.totals.unrealizedPl < 0 ? 'negative' : '' %>" data-number="<%= snapshot.totals.unrealizedPl %>"></strong></div>
      <div class="metric"><span>Realized P/L</span><strong class="<%= snapshot.totals.realizedPl < 0 ? 'negative' : '' %>" data-number="<%= snapshot.totals.realizedPl %>"></strong></div>
      <div class="metric"><span>Day P/L</span><strong class="<%= snapshot.totals.dayPl < 0 ? 'negative' : '' %>" data-number="<%= snapshot.totals.dayPl %>"></strong></div>
      <div class="metric"><span>Active holdings</span><strong><%= snapshot.activeHoldingCount %></strong></div>
    </div>

    <% if (report) { %>
      <h2>Saved Report - <%= report.reportDate %></h2>
      <p class="muted">Generated at <%= report.createdAt %><% if (report.model) { %> with <%= report.model %><% } %>.</p>
      <pre class="report"><%= report.markdown %></pre>

      <% if (report.sources && report.sources.length) { %>
        <h3>Sources</h3>
        <ul>
          <% for (var i = 0; i < report.sources.length; i++) { %>
            <li><a href="<%= report.sources[i].url %>" target="_blank" rel="noreferrer"><%= report.sources[i].title || report.sources[i].url %></a></li>
          <% } %>
        </ul>
      <% } %>
    <% } else { %>
      <h2>No Saved Report Yet</h2>
      <p>Generate a report to save an AI-written daily brief using this local snapshot and current web context.</p>
    <% } %>

    <h2>Top Holdings Sent to OpenAI</h2>
    <table>
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Name</th>
          <th>Class</th>
          <th>Market %</th>
          <th>Day P/L</th>
          <th>Total P/L</th>
        </tr>
      </thead>
      <tbody>
        <% for (var j = 0; j < snapshot.topHoldings.length; j++) { %>
          <tr>
            <td><%= snapshot.topHoldings[j].displaySymbol || snapshot.topHoldings[j].symbol %></td>
            <td><%= snapshot.topHoldings[j].name %></td>
            <td><%= snapshot.topHoldings[j].assetClass %></td>
            <td class="number" data-number="<%= snapshot.topHoldings[j].marketValuePercent %>"></td>
            <td class="number <%= snapshot.topHoldings[j].dayPl < 0 ? 'negative' : '' %>" data-number="<%= snapshot.topHoldings[j].dayPl %>"></td>
            <td class="number <%= snapshot.topHoldings[j].totalPl < 0 ? 'negative' : '' %>" data-number="<%= snapshot.topHoldings[j].totalPl %>"></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>

</html>
