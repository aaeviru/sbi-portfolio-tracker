<html>

<head>
  <meta charset="utf-8">
  <link rel="stylesheet" type="text/css" href="/menu.css">
  <script type="text/javascript">
    function navbarHighLight() {
      var now = document.getElementById("transactions");
      if (now)
        now.className += " active";
    }
    window.onload = navbarHighLight;
  </script>
  <style>
    .content {
      margin: 24px;
      font-family: sans-serif;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 6px;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: #eee;
    }

    .pager {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 12px 0;
    }

    .pager a,
    .pager span {
      display: inline-block;
      padding: 6px 10px;
      border: 1px solid #ccc;
      text-decoration: none;
      color: #333;
    }

    .pager .disabled {
      color: #999;
      background: #eee;
    }

    .pager .status {
      border: none;
      padding-left: 0;
    }
  </style>
</head>

<body>
  <%- include('partials/menu'); -%>
  <div class="content">
    <h1>Transactions</h1>
    <div class="pager">
      <span class="status">
        Showing <%= pagination.start %>-<%= pagination.end %> of <%= pagination.total %>
        (Page <%= pagination.page %> / <%= pagination.totalPages %>)
      </span>
      <% if (pagination.hasPrevious) { %>
        <a href="/transactions?page=<%= pagination.previousPage %>">Previous</a>
      <% } else { %>
        <span class="disabled">Previous</span>
      <% } %>
      <% if (pagination.hasNext) { %>
        <a href="/transactions?page=<%= pagination.nextPage %>">Next</a>
      <% } else { %>
        <span class="disabled">Next</span>
      <% } %>
    </div>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Side</th>
          <th>Symbol</th>
          <th>Name</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>Amount</th>
          <th>Account</th>
        </tr>
      </thead>
      <tbody>
        <% for(var i=0; i<listitem.length; i++) { %>
          <tr>
            <td><%= listitem[i].tradeDateTime %></td>
            <td><%= listitem[i].assetType %></td>
            <td><%= listitem[i].side %></td>
            <td><%= listitem[i].symbol %></td>
            <td><%= listitem[i].assetName %></td>
            <td><%= listitem[i].quantity %></td>
            <td><%= listitem[i].price %></td>
            <td><%= listitem[i].settlementAmount %></td>
            <td><%= listitem[i].account %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
    <div class="pager">
      <% if (pagination.hasPrevious) { %>
        <a href="/transactions?page=<%= pagination.previousPage %>">Previous</a>
      <% } else { %>
        <span class="disabled">Previous</span>
      <% } %>
      <% if (pagination.hasNext) { %>
        <a href="/transactions?page=<%= pagination.nextPage %>">Next</a>
      <% } else { %>
        <span class="disabled">Next</span>
      <% } %>
    </div>
  </div>
</body>

</html>
