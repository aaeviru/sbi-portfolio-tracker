<html>

<head>
  <meta charset="utf-8">
  <link rel="stylesheet" type="text/css" href="/menu.css">
  <script type="text/javascript">
    function navbarHighLight() {
      var now = document.getElementById("trade-chart");
      if (now) {
        now.className += " active";
      }
    }
    window.onload = function () {
      navbarHighLight();
      initTradeChart();
    };
  </script>
  <style>
    .content {
      margin: 24px;
      font-family: sans-serif;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 16px;
      margin: 16px 0;
    }

    label {
      display: block;
      font-size: 13px;
      margin-bottom: 4px;
    }

    select {
      min-width: 420px;
      max-width: 100%;
      padding: 6px;
      font-size: 14px;
    }

    .toolbar select.short-select {
      min-width: 150px;
    }

    .toolbar button {
      padding: 6px 10px;
      font-size: 14px;
    }

    .indicator-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin: 12px 0;
      padding: 10px 12px;
      border: 1px solid #c9d7df;
    }

    .indicator-controls legend {
      padding: 0 6px;
      font-size: 13px;
      font-weight: bold;
    }

    .indicator-controls .indicator-option {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin: 0;
      font-size: 13px;
      white-space: nowrap;
    }

    .indicator-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      min-height: 20px;
      margin: 8px 0;
      font-size: 12px;
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .legend-swatch {
      width: 18px;
      height: 3px;
      background: var(--swatch);
    }

    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 12px 0;
      font-size: 13px;
    }

    .summary span {
      border: 1px solid #ccc;
      padding: 6px 8px;
      background: #f5f5f5;
    }

    .chart-wrap {
      width: 100%;
      overflow-x: auto;
      border: 1px solid #c9d7df;
      background: #fff;
    }

    svg {
      display: block;
      min-width: 900px;
      width: 100%;
      height: 460px;
    }

    svg.indicator-chart {
      height: 180px;
      border-top: 1px solid #d7e1e7;
    }

    svg[hidden] {
      display: none;
    }

    .axis {
      stroke: #555;
      stroke-width: 1;
    }

    .grid {
      stroke: #e6e6e6;
      stroke-width: 1;
    }

    .axis-tick {
      stroke: #777;
      stroke-width: 1;
    }

    .axis-date-label {
      fill: #222;
      font-size: 10px;
    }

    .series-line {
      fill: none;
      stroke: #768894;
      stroke-width: 1.5;
    }

    .history-line {
      fill: none;
      stroke: #2b6da8;
      stroke-width: 2;
    }

    .history-range {
      stroke: #9abbd6;
      stroke-width: 1;
    }

    .sma20-line,
    .sma50-line,
    .sma200-line,
    .bollinger-line,
    .rsi-line,
    .macd-line,
    .macd-signal-line {
      fill: none;
      stroke-width: 1.5;
    }

    .sma20-line {
      stroke: #00897b;
    }

    .sma50-line {
      stroke: #d58a00;
    }

    .sma200-line {
      stroke: #8e3b73;
      stroke-width: 2;
    }

    .bollinger-line {
      stroke: #6b7d8a;
      stroke-width: 1;
    }

    .bollinger-area {
      fill: #d7e4ec;
      opacity: 0.42;
      stroke: none;
    }

    .rsi-line {
      stroke: #147d64;
      stroke-width: 2;
    }

    .rsi-threshold {
      stroke: #c6a15b;
      stroke-width: 1;
      stroke-dasharray: 5 4;
    }

    .macd-line {
      stroke: #2563a6;
      stroke-width: 2;
    }

    .macd-signal-line {
      stroke: #cf6b26;
      stroke-width: 1.5;
    }

    .macd-positive {
      fill: #8bbf9f;
    }

    .macd-negative {
      fill: #e3a09a;
    }

    .buy {
      fill: #0f8b4c;
      stroke: #064b2a;
      stroke-width: 1;
    }

    .sell {
      fill: #d33f2f;
      stroke: #7f1e16;
      stroke-width: 1;
    }

    .axis-label,
    .point-label,
    .empty {
      fill: #222;
      font-size: 12px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin-top: 16px;
    }

    th,
    td {
      border: 1px solid #ddd;
      padding: 6px;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: #eee;
    }

    .side-buy {
      color: #0f6f3f;
      font-weight: bold;
    }

    .side-sell {
      color: #b22a20;
      font-weight: bold;
    }

    .table-pager {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 8px 0 18px;
      font-size: 13px;
    }

    .table-pager button {
      padding: 4px 8px;
      font-size: 13px;
    }

    .table-pager button:disabled {
      color: #999;
    }
  </style>
</head>

<body>
  <%- include('partials/menu'); -%>
  <div class="content">
    <h1>Trade Chart</h1>
    <p class="date-context">Report date (JST): <strong><%= reportDate %></strong></p>

    <% if (assets.length === 0) { %>
      <p>No stock or fund buy/sell transactions are imported yet.</p>
    <% } else { %>
      <div class="toolbar">
        <div>
          <label for="assetSelect">Asset</label>
          <select id="assetSelect"></select>
        </div>
        <div>
          <label for="rangeSelect">Range</label>
          <select id="rangeSelect" class="short-select">
            <option value="1m">1 month</option>
            <option value="6m" selected>6 months</option>
            <option value="1y">1 year</option>
            <option value="all">All</option>
          </select>
        </div>
        <div>
          <label for="tickSelect">X Axis</label>
          <select id="tickSelect" class="short-select">
            <option value="week" selected>Every week</option>
            <option value="month">Every month</option>
            <option value="year">Every year</option>
          </select>
        </div>
        <div>
          <label>Window</label>
          <button type="button" id="olderRangeButton">Previous</button>
          <button type="button" id="newerRangeButton">Next</button>
        </div>
      </div>

      <div id="assetSummary" class="summary"></div>

      <fieldset class="indicator-controls">
        <legend>Technical indicators</legend>
        <label class="indicator-option"><input type="checkbox" id="showSma20" checked> SMA 20</label>
        <label class="indicator-option"><input type="checkbox" id="showSma50" checked> SMA 50</label>
        <label class="indicator-option"><input type="checkbox" id="showSma200" checked> SMA 200</label>
        <label class="indicator-option"><input type="checkbox" id="showBollinger" checked> Bollinger 20/2</label>
        <label class="indicator-option"><input type="checkbox" id="showRsi" checked> RSI 14</label>
        <label class="indicator-option"><input type="checkbox" id="showMacd" checked> MACD 12/26/9</label>
      </fieldset>
      <div id="indicatorLegend" class="indicator-legend" aria-label="Chart legend"></div>

      <div class="chart-wrap">
        <svg id="tradeChart" viewBox="0 0 900 460" role="img" aria-label="Buy and sell price chart"></svg>
        <svg id="rsiChart" class="indicator-chart" viewBox="0 0 900 180" role="img" aria-label="RSI 14 chart"></svg>
        <svg id="macdChart" class="indicator-chart" viewBox="0 0 900 180" role="img" aria-label="MACD 12 26 9 chart"></svg>
      </div>

      <table>
        <caption>Trades</caption>
        <thead>
          <tr>
            <th>SBI Date</th>
            <th>Chart Market Date</th>
            <th>Side</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Amount</th>
            <th>Account</th>
          </tr>
        </thead>
        <tbody id="tradeRows"></tbody>
      </table>
      <div id="tradePager" class="table-pager"></div>

      <table>
        <caption>Saved Price History</caption>
        <thead>
          <tr>
            <th>Provider Price Date</th>
            <th>Date Meaning</th>
            <th>Open</th>
            <th>High</th>
            <th>Low</th>
            <th>Close</th>
            <th>Volume</th>
            <th>Source</th>
            <th>Status</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody id="priceHistoryRows"></tbody>
      </table>
      <div id="priceHistoryPager" class="table-pager"></div>
    <% } %>
  </div>

  <script type="text/javascript">
    var chartAssets = <%- chartDataJson %>;
    var rangePage = 0;
    var tablePageSize = 30;
    var tradeRowsPage = 0;
    var priceHistoryRowsPage = 0;

    function formatNumber(value) {
      if (value === null || value === undefined || value === '') {
        return '-';
      }
      return Number(value).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function svgEl(name, attrs) {
      var el = document.createElementNS('http://www.w3.org/2000/svg', name);
      Object.keys(attrs || {}).forEach(function (key) {
        el.setAttribute(key, attrs[key]);
      });
      return el;
    }

    function dateValue(date) {
      return new Date(date + 'T00:00:00Z').getTime();
    }

    function positiveNumber(value) {
      value = Number(value);
      return isFinite(value) && value > 0 ? value : null;
    }

    function dateTextFromValue(value) {
      return new Date(value).toISOString().slice(0, 10);
    }

    function addMonths(dateText, months) {
      var date = new Date(dateText + 'T00:00:00Z');
      date.setUTCMonth(date.getUTCMonth() + months);
      return date.toISOString().slice(0, 10);
    }

    function addDays(dateText, days) {
      var date = new Date(dateText + 'T00:00:00Z');
      date.setUTCDate(date.getUTCDate() + days);
      return date.toISOString().slice(0, 10);
    }

    function startOfWeek(dateText) {
      var date = new Date(dateText + 'T00:00:00Z');
      var day = date.getUTCDay();
      date.setUTCDate(date.getUTCDate() - day);
      return date.toISOString().slice(0, 10);
    }

    function startOfMonth(dateText) {
      return dateText.slice(0, 8) + '01';
    }

    function startOfYear(dateText) {
      return dateText.slice(0, 4) + '-01-01';
    }

    function getRangeStart(maxDateText, range) {
      if (range === '1m') {
        return addMonths(maxDateText, -1);
      }
      if (range === '6m') {
        return addMonths(maxDateText, -6);
      }
      if (range === '1y') {
        return addMonths(maxDateText, -12);
      }
      return '';
    }

    function getRangeMonths(range) {
      if (range === '1m') {
        return 1;
      }
      if (range === '6m') {
        return 6;
      }
      if (range === '1y') {
        return 12;
      }
      return 0;
    }

    function buildAxisTicks(minDateText, maxDateText, interval) {
      var ticks = [];
      var cursor;
      if (interval === 'day') {
        cursor = minDateText;
      } else if (interval === 'week') {
        cursor = startOfWeek(minDateText);
      } else if (interval === 'month') {
        cursor = startOfMonth(minDateText);
      } else {
        cursor = startOfYear(minDateText);
      }

      while (cursor <= maxDateText) {
        if (cursor >= minDateText) {
          ticks.push(cursor);
        }
        if (interval === 'day') {
          cursor = addDays(cursor, 1);
        } else if (interval === 'week') {
          cursor = addDays(cursor, 7);
        } else if (interval === 'month') {
          cursor = addMonths(cursor, 1);
        } else {
          cursor = addMonths(cursor, 12);
        }
      }
      return ticks;
    }

    function updateRangeButtons(range, page, startDate, endDate, minDate, maxDate) {
      var older = document.getElementById('olderRangeButton');
      var newer = document.getElementById('newerRangeButton');
      var disabled = range === 'all';
      older.disabled = disabled || startDate <= minDate;
      newer.disabled = disabled || page <= 0 || endDate >= maxDate;
    }

    function setText(parent, x, y, value, className, anchor) {
      var text = svgEl('text', {
        x: x,
        y: y,
        class: className || 'axis-label',
        'text-anchor': anchor || 'start'
      });
      text.textContent = value;
      parent.appendChild(text);
      return text;
    }

    function indicatorEnabled(id) {
      var control = document.getElementById(id);
      return !!(control && control.checked);
    }

    function appendLine(svg, rows, valueForRow, xFor, yFor, className, titleText) {
      var points = rows.filter(function (row) {
        return Number.isFinite(valueForRow(row));
      }).map(function (row) {
        return xFor(row.date) + ',' + yFor(valueForRow(row));
      }).join(' ');
      if (!points) {
        return;
      }

      var line = svgEl('polyline', { points: points, class: className });
      if (titleText) {
        var title = svgEl('title');
        title.textContent = titleText;
        line.appendChild(title);
      }
      svg.appendChild(line);
    }

    function renderIndicatorLegend() {
      var legend = document.getElementById('indicatorLegend');
      legend.innerHTML = '';
      [
        { label: 'Close', color: '#2b6da8', enabled: true },
        { label: 'SMA 20', color: '#00897b', enabled: indicatorEnabled('showSma20') },
        { label: 'SMA 50', color: '#d58a00', enabled: indicatorEnabled('showSma50') },
        { label: 'SMA 200', color: '#8e3b73', enabled: indicatorEnabled('showSma200') },
        { label: 'Bollinger 20/2', color: '#6b7d8a', enabled: indicatorEnabled('showBollinger') },
        { label: 'RSI 14', color: '#147d64', enabled: indicatorEnabled('showRsi') },
        { label: 'MACD', color: '#2563a6', enabled: indicatorEnabled('showMacd') },
        { label: 'MACD signal', color: '#cf6b26', enabled: indicatorEnabled('showMacd') }
      ].filter(function (item) {
        return item.enabled;
      }).forEach(function (item) {
        var wrapper = document.createElement('span');
        wrapper.className = 'legend-item';
        var swatch = document.createElement('span');
        swatch.className = 'legend-swatch';
        swatch.style.setProperty('--swatch', item.color);
        var label = document.createElement('span');
        label.textContent = item.label;
        wrapper.appendChild(swatch);
        wrapper.appendChild(label);
        legend.appendChild(wrapper);
      });
    }

    function renderSummary(asset) {
      var summary = document.getElementById('assetSummary');
      summary.innerHTML = '';
      var values = [
        asset.displaySymbol + ' / ' + asset.name,
        asset.assetType,
        asset.priceUnit,
        'BUY ' + asset.buyCount,
        'SELL ' + asset.sellCount,
        'Trades ' + asset.firstDate + ' to ' + asset.lastDate,
        'Completed ' + (asset.priceDateLabel || 'price date') + ' history ' + (asset.completedHistoryCount || 0) + (asset.completedHistoryFirstDate ? ' / ' + asset.completedHistoryFirstDate + ' to ' + asset.completedHistoryLastDate : ''),
        'Live snapshots ' + (asset.snapshotCount || 0)
      ];
      var technical = asset.technicalIndicators || {};
      values.push('Indicators ' + (technical.status || 'NO_HISTORY'));
      if (technical.rsi14 != null) {
        values.push('RSI 14 ' + formatNumber(technical.rsi14));
      }
      if (technical.realizedVolatility20DayAnnualizedPercent != null) {
        values.push('20d volatility ' + formatNumber(technical.realizedVolatility20DayAnnualizedPercent) + '%');
      }
      if (technical.range52Week) {
        values.push('52w high / low ' + formatNumber(technical.range52Week.high) + ' / ' + formatNumber(technical.range52Week.low));
        values.push('Drawdown ' + formatNumber(technical.range52Week.drawdownPercent) + '%');
      }
      values.forEach(function (value) {
        var item = document.createElement('span');
        item.textContent = value;
        summary.appendChild(item);
      });
    }

    function renderRsiChart(rows, minDate, maxDate) {
      var svg = document.getElementById('rsiChart');
      svg.innerHTML = '';
      svg.hidden = !indicatorEnabled('showRsi');
      if (svg.hidden) {
        return;
      }

      var width = 900;
      var height = 180;
      var left = 78;
      var right = 28;
      var top = 24;
      var bottom = 24;
      var innerWidth = width - left - right;
      var innerHeight = height - top - bottom;
      var validRows = rows.filter(function (row) { return row.rsi14 != null; });

      setText(svg, left, 16, 'RSI 14', 'axis-label');
      if (!validRows.length) {
        setText(svg, left, 88, 'Not enough price history for RSI 14.', 'empty');
        return;
      }

      function xFor(date) {
        return minDate === maxDate ? left + innerWidth / 2 :
          left + ((dateValue(date) - minDate) / (maxDate - minDate)) * innerWidth;
      }
      function yFor(value) {
        return top + (1 - (value / 100)) * innerHeight;
      }

      [30, 50, 70].forEach(function (value) {
        var y = yFor(value);
        svg.appendChild(svgEl('line', {
          x1: left,
          y1: y,
          x2: width - right,
          y2: y,
          class: value === 50 ? 'grid' : 'rsi-threshold'
        }));
        setText(svg, left - 10, y + 4, value, 'axis-label', 'end');
      });
      svg.appendChild(svgEl('line', { x1: left, y1: top, x2: left, y2: height - bottom, class: 'axis' }));
      svg.appendChild(svgEl('line', { x1: left, y1: height - bottom, x2: width - right, y2: height - bottom, class: 'axis' }));
      appendLine(svg, validRows, function (row) { return row.rsi14; }, xFor, yFor, 'rsi-line', 'RSI 14');
    }

    function renderMacdChart(rows, minDate, maxDate) {
      var svg = document.getElementById('macdChart');
      svg.innerHTML = '';
      svg.hidden = !indicatorEnabled('showMacd');
      if (svg.hidden) {
        return;
      }

      var width = 900;
      var height = 180;
      var left = 78;
      var right = 28;
      var top = 24;
      var bottom = 24;
      var innerWidth = width - left - right;
      var innerHeight = height - top - bottom;
      var validRows = rows.filter(function (row) { return !!row.macd12_26_9; });

      setText(svg, left, 16, 'MACD 12/26/9', 'axis-label');
      if (!validRows.length) {
        setText(svg, left, 88, 'Not enough price history for MACD 12/26/9.', 'empty');
        return;
      }

      var values = [0];
      validRows.forEach(function (row) {
        values.push(row.macd12_26_9.line, row.macd12_26_9.signal, row.macd12_26_9.histogram);
      });
      var minValue = Math.min.apply(null, values);
      var maxValue = Math.max.apply(null, values);
      var padding = minValue === maxValue ? 1 : (maxValue - minValue) * 0.12;
      minValue -= padding;
      maxValue += padding;

      function xFor(date) {
        return minDate === maxDate ? left + innerWidth / 2 :
          left + ((dateValue(date) - minDate) / (maxDate - minDate)) * innerWidth;
      }
      function yFor(value) {
        return top + (1 - ((value - minValue) / (maxValue - minValue))) * innerHeight;
      }

      for (var i = 0; i <= 2; i++) {
        var gridValue = maxValue - (maxValue - minValue) * (i / 2);
        var gridY = yFor(gridValue);
        svg.appendChild(svgEl('line', { x1: left, y1: gridY, x2: width - right, y2: gridY, class: 'grid' }));
        setText(svg, left - 10, gridY + 4, formatNumber(gridValue), 'axis-label', 'end');
      }
      var zeroY = yFor(0);
      svg.appendChild(svgEl('line', { x1: left, y1: zeroY, x2: width - right, y2: zeroY, class: 'axis' }));
      svg.appendChild(svgEl('line', { x1: left, y1: top, x2: left, y2: height - bottom, class: 'axis' }));

      var barWidth = Math.max(1, Math.min(6, innerWidth / Math.max(validRows.length, 1) * 0.7));
      validRows.forEach(function (row) {
        var value = row.macd12_26_9.histogram;
        var valueY = yFor(value);
        svg.appendChild(svgEl('rect', {
          x: xFor(row.date) - barWidth / 2,
          y: Math.min(valueY, zeroY),
          width: barWidth,
          height: Math.max(1, Math.abs(zeroY - valueY)),
          class: value >= 0 ? 'macd-positive' : 'macd-negative'
        }));
      });
      appendLine(svg, validRows, function (row) { return row.macd12_26_9.line; }, xFor, yFor, 'macd-line', 'MACD line');
      appendLine(svg, validRows, function (row) { return row.macd12_26_9.signal; }, xFor, yFor, 'macd-signal-line', 'MACD signal');
    }

    function renderChart(asset) {
      var svg = document.getElementById('tradeChart');
      svg.innerHTML = '';
      var rsiSvg = document.getElementById('rsiChart');
      var macdSvg = document.getElementById('macdChart');
      rsiSvg.innerHTML = '';
      macdSvg.innerHTML = '';
      rsiSvg.hidden = !indicatorEnabled('showRsi');
      macdSvg.hidden = !indicatorEnabled('showMacd');
      renderIndicatorLegend();

      var width = 900;
      var height = 460;
      var left = 78;
      var right = 28;
      var top = 28;
      var bottom = 96;
      var innerWidth = width - left - right;
      var innerHeight = height - top - bottom;
      var points = asset.points || [];
      var history = asset.priceHistory || [];
      var indicatorSeries = asset.technicalIndicatorSeries || [];
      var range = document.getElementById('rangeSelect').value;
      var tickInterval = document.getElementById('tickSelect').value;

      if (points.length === 0 && history.length === 0) {
        setText(svg, 30, 50, 'No trade or price history points for this asset.', 'empty');
        return;
      }

      var allDateValues = points.map(function (p) { return dateValue(p.marketDate || p.date); }).concat(history.map(function (row) { return dateValue(row.date); }));
      var allMinDateText = dateTextFromValue(Math.min.apply(null, allDateValues));
      var allMaxDateText = dateTextFromValue(Math.max.apply(null, allDateValues));
      var rangeMonths = getRangeMonths(range);
      var rangeEnd = rangeMonths ? addMonths(allMaxDateText, -rangePage * rangeMonths) : allMaxDateText;
      if (rangeEnd < allMinDateText) {
        rangeEnd = allMinDateText;
      }
      var rangeStart = rangeMonths ? getRangeStart(rangeEnd, range) : '';
      if (rangeStart && rangeStart < allMinDateText) {
        rangeStart = allMinDateText;
      }
      var visiblePoints = points.filter(function (point) {
        var d = point.marketDate || point.date;
        return (!rangeStart || d >= rangeStart) && (!rangeMonths || d <= rangeEnd);
      });
      var visibleHistory = history.filter(function (row) {
        return (!rangeStart || row.date >= rangeStart) && (!rangeMonths || row.date <= rangeEnd);
      });
      var visibleIndicators = indicatorSeries.filter(function (row) {
        return (!rangeStart || row.date >= rangeStart) && (!rangeMonths || row.date <= rangeEnd);
      });

      updateRangeButtons(range, rangePage, rangeStart || allMinDateText, rangeEnd, allMinDateText, allMaxDateText);

      if (visiblePoints.length === 0 && visibleHistory.length === 0) {
        setText(svg, 30, 50, 'No trade or price history points in this range.', 'empty');
        return;
      }

      var dateValues = visiblePoints.map(function (p) { return dateValue(p.marketDate || p.date); }).concat(visibleHistory.map(function (row) { return dateValue(row.date); }));
      var minDate = Math.min.apply(null, dateValues);
      var maxDate = Math.max.apply(null, dateValues);
      var minDateText = dateTextFromValue(minDate);
      var maxDateText = dateTextFromValue(maxDate);
      var prices = visiblePoints.map(function (p) { return positiveNumber(p.price); }).filter(function (price) { return price !== null; });
      visibleHistory.forEach(function (row) {
        ['open', 'high', 'low', 'close'].forEach(function (key) {
          var price = positiveNumber(row[key]);
          if (price !== null) {
            prices.push(price);
          }
        });
      });
      visibleIndicators.forEach(function (row) {
        if (indicatorEnabled('showSma20') && positiveNumber(row.sma20) !== null) {
          prices.push(row.sma20);
        }
        if (indicatorEnabled('showSma50') && positiveNumber(row.sma50) !== null) {
          prices.push(row.sma50);
        }
        if (indicatorEnabled('showSma200') && positiveNumber(row.sma200) !== null) {
          prices.push(row.sma200);
        }
        if (indicatorEnabled('showBollinger') && row.bollinger20_2) {
          prices.push(row.bollinger20_2.lower, row.bollinger20_2.upper);
        }
      });
      if (prices.length === 0) {
        setText(svg, 30, 50, 'No positive price values for this asset.', 'empty');
        return;
      }
      var minPrice = Math.min.apply(null, prices);
      var maxPrice = Math.max.apply(null, prices);
      var pricePadding = minPrice === maxPrice ? Math.max(1, minPrice * 0.1) : (maxPrice - minPrice) * 0.08;
      minPrice -= pricePadding;
      maxPrice += pricePadding;

      function xFor(date) {
        if (minDate === maxDate) {
          return left + innerWidth / 2;
        }
        return left + ((dateValue(date) - minDate) / (maxDate - minDate)) * innerWidth;
      }

      function yFor(price) {
        return top + (1 - ((price - minPrice) / (maxPrice - minPrice))) * innerHeight;
      }

      for (var i = 0; i <= 4; i++) {
        var y = top + innerHeight * (i / 4);
        var price = maxPrice - (maxPrice - minPrice) * (i / 4);
        svg.appendChild(svgEl('line', { x1: left, y1: y, x2: width - right, y2: y, class: 'grid' }));
        setText(svg, left - 10, y + 4, formatNumber(price), 'axis-label', 'end');
      }

      svg.appendChild(svgEl('line', { x1: left, y1: top, x2: left, y2: height - bottom, class: 'axis' }));
      svg.appendChild(svgEl('line', { x1: left, y1: height - bottom, x2: width - right, y2: height - bottom, class: 'axis' }));
      setText(svg, left, 18, asset.priceUnit, 'axis-label');

      var axisTicks = buildAxisTicks(minDateText, maxDateText, tickInterval);
      var tickLabelStep = Math.max(1, Math.ceil(axisTicks.length / 28));
      axisTicks.forEach(function (tickDate, index) {
        var x = xFor(tickDate);
        svg.appendChild(svgEl('line', {
          x1: x,
          y1: height - bottom,
          x2: x,
          y2: height - bottom + 6,
          class: 'axis-tick'
        }));
        if (index % tickLabelStep === 0) {
          var label = setText(svg, x - 4, height - bottom + 56, tickDate, 'axis-date-label', 'end');
          label.setAttribute('transform', 'rotate(-45 ' + (x - 4) + ' ' + (height - bottom + 56) + ')');
        }
      });

      visibleHistory.forEach(function (row) {
        var high = positiveNumber(row.high);
        var low = positiveNumber(row.low);
        if (high !== null && low !== null) {
          var x = xFor(row.date);
          svg.appendChild(svgEl('line', { x1: x, y1: yFor(high), x2: x, y2: yFor(low), class: 'history-range' }));
        }
      });

      if (indicatorEnabled('showBollinger')) {
        var bollingerRows = visibleIndicators.filter(function (row) {
          return row.bollinger20_2 && positiveNumber(row.bollinger20_2.lower) !== null &&
            positiveNumber(row.bollinger20_2.upper) !== null;
        });
        if (bollingerRows.length) {
          var upperPoints = bollingerRows.map(function (row) {
            return xFor(row.date) + ',' + yFor(row.bollinger20_2.upper);
          });
          var lowerPoints = bollingerRows.slice().reverse().map(function (row) {
            return xFor(row.date) + ',' + yFor(row.bollinger20_2.lower);
          });
          svg.appendChild(svgEl('polygon', { points: upperPoints.concat(lowerPoints).join(' '), class: 'bollinger-area' }));
          appendLine(svg, bollingerRows, function (row) { return row.bollinger20_2.upper; }, xFor, yFor, 'bollinger-line', 'Bollinger upper band');
          appendLine(svg, bollingerRows, function (row) { return row.bollinger20_2.lower; }, xFor, yFor, 'bollinger-line', 'Bollinger lower band');
        }
      }
      if (indicatorEnabled('showSma20')) {
        appendLine(svg, visibleIndicators, function (row) { return row.sma20; }, xFor, yFor, 'sma20-line', 'SMA 20');
      }
      if (indicatorEnabled('showSma50')) {
        appendLine(svg, visibleIndicators, function (row) { return row.sma50; }, xFor, yFor, 'sma50-line', 'SMA 50');
      }
      if (indicatorEnabled('showSma200')) {
        appendLine(svg, visibleIndicators, function (row) { return row.sma200; }, xFor, yFor, 'sma200-line', 'SMA 200');
      }
      if (visibleHistory.length > 0) {
        var historyLinePoints = visibleHistory.filter(function (row) {
          return positiveNumber(row.close) !== null;
        }).map(function (row) {
          return xFor(row.date) + ',' + yFor(positiveNumber(row.close));
        }).join(' ');
        if (historyLinePoints) {
          svg.appendChild(svgEl('polyline', { points: historyLinePoints, class: 'history-line' }));
        }
      }

      var linePoints = visiblePoints.map(function (p) {
        return xFor(p.marketDate || p.date) + ',' + yFor(p.price);
      }).join(' ');
      if (linePoints) {
        svg.appendChild(svgEl('polyline', { points: linePoints, class: 'series-line' }));
      }

      visiblePoints.forEach(function (point) {
        var x = xFor(point.marketDate || point.date);
        var y = yFor(point.price);
        var marker;
        if (point.side === 'SELL') {
          marker = svgEl('rect', { x: x - 5, y: y - 5, width: 10, height: 10, class: 'sell' });
        } else {
          marker = svgEl('circle', { cx: x, cy: y, r: 5, class: 'buy' });
        }
        var title = svgEl('title');
        title.textContent = point.date + (point.marketDate && point.marketDate !== point.date ? ' / market ' + point.marketDate : '') +
          ' ' + point.side + ' price ' + formatNumber(point.price) +
          ' qty ' + formatNumber(point.quantity);
        marker.appendChild(title);
        svg.appendChild(marker);
      });
      renderRsiChart(visibleIndicators, minDate, maxDate);
      renderMacdChart(visibleIndicators, minDate, maxDate);
    }

    function paginateRows(rows, page) {
      var totalRows = rows.length;
      var totalPages = Math.max(1, Math.ceil(totalRows / tablePageSize));
      var safePage = Math.min(Math.max(page, 0), totalPages - 1);
      return {
        rows: rows.slice(safePage * tablePageSize, safePage * tablePageSize + tablePageSize),
        page: safePage,
        totalPages: totalPages,
        totalRows: totalRows
      };
    }

    function renderPager(elementId, pageInfo, onPageChange) {
      var pager = document.getElementById(elementId);
      pager.innerHTML = '';
      if (!pageInfo || pageInfo.totalRows <= tablePageSize) {
        return;
      }

      var previous = document.createElement('button');
      previous.type = 'button';
      previous.textContent = 'Previous';
      previous.disabled = pageInfo.page <= 0;
      previous.addEventListener('click', function () {
        onPageChange(pageInfo.page - 1);
      });

      var status = document.createElement('span');
      status.textContent = 'Page ' + (pageInfo.page + 1) + ' / ' + pageInfo.totalPages +
        ' (' + pageInfo.totalRows.toLocaleString() + ' rows)';

      var next = document.createElement('button');
      next.type = 'button';
      next.textContent = 'Next';
      next.disabled = pageInfo.page >= pageInfo.totalPages - 1;
      next.addEventListener('click', function () {
        onPageChange(pageInfo.page + 1);
      });

      pager.appendChild(previous);
      pager.appendChild(status);
      pager.appendChild(next);
    }

    function renderPriceHistoryRows(asset) {
      var body = document.getElementById('priceHistoryRows');
      body.innerHTML = '';
      var rows = (asset.priceHistory || []).slice().reverse();
      var pageInfo = paginateRows(rows, priceHistoryRowsPage);
      priceHistoryRowsPage = pageInfo.page;

      pageInfo.rows.forEach(function (row) {
        var tr = document.createElement('tr');
        [
          row.date,
          (row.dateBasis || 'SOURCE_DATE') + (row.sourceTimezone ? ' / ' + row.sourceTimezone : '') + (row.sessionStatus ? ' / ' + row.sessionStatus : ''),
          formatNumber(row.open),
          formatNumber(row.high),
          formatNumber(row.low),
          formatNumber(row.close),
          row.volume === null || row.volume === undefined ? '-' : Number(row.volume).toLocaleString(),
          row.source || '',
          row.status || '',
          row.error || (row.fxRateDate && row.fxRateDate !== row.date ? 'FX ' + row.fxRateDate : '')
        ].forEach(function (value) {
          var td = document.createElement('td');
          td.textContent = value;
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });

      if (!asset.priceHistory || asset.priceHistory.length === 0) {
        var tr = document.createElement('tr');
        var td = document.createElement('td');
        td.colSpan = 10;
        td.textContent = 'No saved price history yet. Use Update Prices on the Summary page.';
        tr.appendChild(td);
        body.appendChild(tr);
      }

      renderPager('priceHistoryPager', pageInfo, function (page) {
        priceHistoryRowsPage = page;
        renderPriceHistoryRows(asset);
      });
    }

    function renderRows(asset) {
      var body = document.getElementById('tradeRows');
      body.innerHTML = '';
      var rows = (asset.points || []).slice().reverse();
      var pageInfo = paginateRows(rows, tradeRowsPage);
      tradeRowsPage = pageInfo.page;

      pageInfo.rows.forEach(function (point) {
        var tr = document.createElement('tr');
        var sideClass = point.side === 'BUY' ? 'side-buy' : 'side-sell';
        [
          point.date,
          point.marketDate || point.date,
          point.side,
          formatNumber(point.price),
          formatNumber(point.quantity),
          formatNumber(point.amount),
          point.account || ''
        ].forEach(function (value, index) {
          var td = document.createElement('td');
          td.textContent = value;
          if (index === 2) {
            td.className = sideClass;
          }
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });

      renderPager('tradePager', pageInfo, function (page) {
        tradeRowsPage = page;
        renderRows(asset);
      });
    }

    function renderSelectedAsset() {
      var select = document.getElementById('assetSelect');
      var asset = chartAssets[Number(select.value)];
      if (!asset) {
        return;
      }
      tradeRowsPage = 0;
      priceHistoryRowsPage = 0;
      renderSummary(asset);
      renderChart(asset);
      renderRows(asset);
      renderPriceHistoryRows(asset);
    }

    function initTradeChart() {
      if (!chartAssets || chartAssets.length === 0) {
        return;
      }

      var select = document.getElementById('assetSelect');
      chartAssets.forEach(function (asset, index) {
        var option = document.createElement('option');
        option.value = index;
        option.textContent = asset.displaySymbol + ' - ' + asset.name;
        select.appendChild(option);
      });
      select.addEventListener('change', renderSelectedAsset);
      document.getElementById('rangeSelect').addEventListener('change', function () {
        rangePage = 0;
        renderSelectedAsset();
      });
      document.getElementById('tickSelect').addEventListener('change', renderSelectedAsset);
      [
        'showSma20',
        'showSma50',
        'showSma200',
        'showBollinger',
        'showRsi',
        'showMacd'
      ].forEach(function (id) {
        document.getElementById(id).addEventListener('change', renderSelectedAsset);
      });
      document.getElementById('olderRangeButton').addEventListener('click', function () {
        rangePage++;
        renderSelectedAsset();
      });
      document.getElementById('newerRangeButton').addEventListener('click', function () {
        rangePage = Math.max(0, rangePage - 1);
        renderSelectedAsset();
      });
      renderSelectedAsset();
    }
  </script>
</body>

</html>
