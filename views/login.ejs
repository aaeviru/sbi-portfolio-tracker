<html>

<head>
  <meta charset="utf-8">
  <title>SBI Portfolio Tracker Login</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: sans-serif;
      background: #e5e7eb;
    }

    .login {
      width: 320px;
      padding: 20px;
      border: 1px solid #b7c7d0;
      background: #f6fbfd;
    }

    h1 {
      margin: 0 0 16px;
      font-size: 24px;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 14px;
    }

    input {
      padding: 8px;
      font-size: 16px;
    }

    button {
      width: 100%;
      margin-top: 14px;
      padding: 8px;
      font-size: 16px;
    }

    .error {
      margin: 0 0 12px;
      color: #c00;
    }
  </style>
</head>

<body>
  <form class="login" action="/login" method="post">
    <h1>Login</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <input type="hidden" name="next" value="<%= next %>">
    <label>
      Password
      <input type="password" name="password" autocomplete="current-password" required autofocus>
    </label>
    <button type="submit">Login</button>
  </form>
</body>

</html>
